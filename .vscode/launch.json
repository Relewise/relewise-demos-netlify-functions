{
  "configurations": [
  {
    "name": "Attach by Process ID",
    "processId": "${command:PickProcess}",
    "request": "attach",
    "outFiles": ["${workspaceFolder}/.netlify/functions-serve/**/*.mjs"],
    "skipFiles": [
      "<node_internals>/**"
    ],
    "type": "node",
    "sourceMaps": true,
    "resolveSourceMapLocations": [
      "${workspaceFolder}/src/**/*.mts",
      "${workspaceFolder}/**",
      "!**/node_modules/**"
    ]
  }
  ]
}
